# --- База ---
DATABASE_URL=postgresql+asyncpg://cinema:cinema@localhost:5433/cinema

# --- Telegram ---
# Получить у @BotFather: /newbot, затем /newapp для Mini App
TELEGRAM_BOT_TOKEN=
# HTTPS-адрес Mini App (localhost Telegram не принимает).
# В разработке — адрес туннеля, см. README.
MINIAPP_URL=

# Имя бота без @ (нужно для ссылок вида t.me/<bot>/app)
TELEGRAM_BOT_USERNAME=

# --- TMDB ---
# https://www.themoviedb.org/settings/api — API Read Access Token (v4, длинный JWT).
# Нужен для поиска фильмов вне каталога и оценок TMDB. Без него приложение
# работает, но каталог пополняется только импортом из Кинопоиска.
TMDB_API_TOKEN=
TMDB_LANGUAGE=ru-RU

# --- Кинопоиск ---
# https://kinopoisk.dev/ — бесплатный токен.
# Нужен обязательно: каталог наполняется из Кинопоиска (см. docs/DEVELOPMENT.md),
# а постеры оттуда грузятся там, где image.tmdb.org заблокирован.
KINOPOISK_API_TOKEN=

# --- Приложение ---
# Секрет для подписи сессионных JWT. Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
DISPLAY_TIMEZONE=Europe/Moscow
# Telegram ID первого суперадмина: узнать, написав боту @userinfobot.
# Этот человек получает права главного админа при первом входе.
BOOTSTRAP_SUPERADMIN_TG_ID=

# --- Только для боя (docker-compose.prod.yml) ---
# Пароль роли postgres в контейнере базы: openssl rand -hex 24
# В разработке не нужен — DATABASE_URL выше уже содержит пароль.
# POSTGRES_PASSWORD=
