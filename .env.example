# --- База ---
DATABASE_URL=postgresql+asyncpg://cinema:cinema@localhost:5433/cinema

# --- Telegram ---
# Получить у @BotFather: /newbot, затем /newapp для Mini App
TELEGRAM_BOT_TOKEN=
# HTTPS-адрес Mini App (localhost Telegram не принимает).
# В разработке — адрес туннеля, см. README.
MINIAPP_URL=

# Имя бота без @ (нужно для ссылок вида t.me/<bot>/app)
TELEGRAM_BOT_USERNAME=

# --- TMDB ---
# https://www.themoviedb.org/settings/api — API Read Access Token (v4, длинный JWT)
TMDB_API_TOKEN=
TMDB_LANGUAGE=ru-RU

# --- Кинопоиск (опционально, ленивая подгрузка) ---
# https://kinopoisk.dev/ — бесплатный токен
KINOPOISK_API_TOKEN=

# --- Приложение ---
# Секрет для подписи сессионных JWT. Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
DISPLAY_TIMEZONE=Europe/Moscow
# Telegram ID первого суперадмина: узнать, написав боту @userinfobot
BOOTSTRAP_SUPERADMIN_TG_ID=
